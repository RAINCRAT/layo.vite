# ===== 站点基础配置（VITE_SITE_*，config.js 读取）=====

# 站点部署根地址 —— 全站唯一 URL 来源，避免在代码中硬编码域名。
# 构建时由它派生：sitemap.xml、robots.txt、llms.txt、canonical、OG 等。
# 更换部署域名只需修改此处；留空则跳过需要绝对地址的 SEO 产物。
VITE_SITE_URL=https://layoserve.raincrat.top/

# 站点名称（VitePress title / 页面 <title>）
VITE_SITE_NAME=LAYOSERVE泠域存储

# 站点描述（VitePress 默认 meta description）
# 允许换行：值用双引号包裹、用 \n 表示换行；也可在双引号内直接书写真实换行（多行值）。
# 代码侧会统一把原样保留的 \n 归为真实换行，忘记加引号也能生效。
VITE_SITE_DESCRIPTION="RAINCRAT雨绘巷·LAYOSERVE泠域存储"

# 站点语言（html lang）
VITE_SITE_LANG=zh-CN

# 浏览器主题色（theme-color）
VITE_SITE_THEME_COLOR=#0e86b8

# ===== SEO 独立配置（VITE_SEO_*，seo-config.js 读取；未设置时回退到站点基础配置）=====

# SEO 站名（og:site_name / JSON-LD name / llms.txt 标题等）——搜索引擎展示的来源名称
VITE_SEO_SITE_NAME=LAYOSERVE泠域存储

# 页面标题后缀：所有内容页 <title> 与 og:title 的 `| 后缀`（如「页面标题 | 泠域存储LAYOSERVE」）；
# 与 SEO 站名独立，未设置时回退到 VITE_SEO_SITE_NAME；首页 title 即站名本身（不带竖线）
VITE_SEO_TITLE_SUFFIX=泠域存储LAYOSERVE

# IndexNow 推送密钥（Bing/搜狗等搜索引擎即时收录通知协议）：
# 构建时会在站点根生成 {key}.txt 密钥文件，并向 api.indexnow.org 推送 sitemap 全部 URL。
# 密钥与域名绑定，更换域名需在 IndexNow 官网重新生成。
VITE_INDEXNOW_KEY=a666232be9f944c4a44114ca4f625561

# SEO 描述（og:description / JSON-LD description / llms.txt 描述）
# 允许换行，写法同 VITE_SITE_DESCRIPTION（双引号 + \n，或双引号内真实换行）。
VITE_SEO_SITE_DESCRIPTION=LAYOSERVE泠域存储 是 RAINCRAT雨绘巷 企划下的主打存储类产品的子企划。

# JSON-LD 备选站名（逗号分隔，可多个）：WebSite/Organization 的 alternateName，
# 帮助搜索引擎把品牌词与站点身份关联（域名 raincrat.top 与品牌 LAYOSERVE泠域存储不一致时尤为重要）。
# 建议包含中文品牌、英文品牌与简称。
VITE_SEO_ALT_NAMES=泠域存储,LAYOSERVE,泠域

# 作者（meta author / JSON-LD author）
VITE_SEO_AUTHOR=LAYOSERVE

# Open Graph 语言（og:locale）
VITE_SEO_OG_LOCALE=zh_CN

# Twitter 卡片类型（twitter:card）
VITE_SEO_TWITTER_CARD=summary

# robots meta 内容
VITE_SEO_ROBOTS_CONTENT=index, follow
